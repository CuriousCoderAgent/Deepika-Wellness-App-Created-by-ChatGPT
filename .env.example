# Bharosa-owned pooled PostgreSQL connection. Production intentionally ignores
# generic legacy DATABASE_URL/POSTGRES_URL values so it cannot silently share
# the protected Deepika deployment's database.
BHAROSA_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Authentication and opaque private-file references. Use independent random
# values of at least 32 bytes and never prefix either with NEXT_PUBLIC_.
AUTH_SECRET=replace-with-a-random-secret
FILE_TOKEN_SECRET=replace-with-a-different-random-secret

# Password-reset email (Resend). The sender must be verified in Resend before
# real customer email can be delivered.
RESEND_API_KEY=re_replace_me
BHAROSA_EMAIL_FROM=Bharosa Wellness <care@example.com>
BHAROSA_APP_URL=https://your-bharosa-backend.example.com

# Private Vercel Blob store. Link a store configured for private access.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Closed-pilot controls. SIGNUP_CODE is required in production until verified
# email activation is implemented. MEMBERS may remain empty when members use
# database-backed self-signup.
COACH_PASSWORD=replace-me
MEMBERS=
SIGNUP_CODE=replace-with-a-private-invitation-code

# Optional bounded recommendations; server-side only.
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=
